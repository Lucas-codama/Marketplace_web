<section class="hero mb-5">
  <span class="eyebrow">Loja com vários vendedores</span>
  <h1>O próximo nível começa nos seus equipamentos.</h1>
  <p>Consoles, jogos e acessórios de lojas independentes em uma experiência rápida, segura e feita para jogar.</p>
  <form class="hero-search" action="/catalogo">
    <input name="busca" type="search" placeholder="O que você procura?" aria-label="Pesquisar produtos">
    <button class="btn btn-success">Pesquisar</button>
  </form>
  <div class="hero-actions">
    <a href="/catalogo" class="btn btn-outline-light">Explorar catálogo</a>
    <% if (!usuario) { %>
      <a href="/cadastro" class="btn btn-link text-white">Criar minha conta →</a>
    <% } %>
  </div>
  <div class="hero-stat">
    <div>
      <strong><%= categorias.length %></strong>
      <span>categorias</span>
    </div>
    <div>
      <strong><%= destaques.length %></strong>
      <span>seleções em destaque</span>
    </div>
    <div>
      <strong>24/7</strong>
      <span>catálogo disponível</span>
    </div>
  </div>
</section>
<section class="section-block">
  <div class="section-heading">
    <div>
      <span class="eyebrow">Seleção NXT</span>
      <h2>Destaques</h2>
    </div>
    <a href="/catalogo">Ver tudo →</a>
  </div>
  <div class="row g-3">
    <% destaques.forEach((produto) => { %>
      <div class="col-6 col-lg-3"><%- include('partials/produto-card', { produto }) %></div>
    <% }) %>
  </div>
</section>
<section class="section-block">
  <div class="section-heading">
    <div>
      <span class="eyebrow">Descubra</span>
      <h2>Categorias</h2>
    </div>
  </div>
  <div class="category-grid">
    <% categorias.forEach((categoria, indice) => { %>
      <a href="/catalogo?categoria=<%= categoria.id %>" class="category-tile">
        <span>0<%= indice + 1 %></span>
        <strong><%= categoria.nome %></strong>
      </a>
    <% }) %>
  </div>
</section>
<section class="section-block">
  <div class="section-heading">
    <div>
      <span class="eyebrow">Acabaram de chegar</span>
      <h2>Recentes</h2>
    </div>
  </div>
  <div class="row g-3">
    <% recentes.forEach((produto) => { %>
      <div class="col-6 col-lg-3"><%- include('partials/produto-card', { produto }) %></div>
    <% }) %>
  </div>
</section>
