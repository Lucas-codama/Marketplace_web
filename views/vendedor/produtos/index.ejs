<section>
  <div class="section-heading">
    <div>
      <span class="eyebrow">Sua loja</span>
      <h1>Produtos</h1>
    </div>
    <a class="btn btn-dark" href="/vendedor/produtos/novo">Cadastrar produto</a>
  </div>
  <div class="surface overflow-hidden">
    <p id="ajudaRolagemProdutos" class="visually-hidden">Use as setas para a esquerda e para a direita para percorrer todas as colunas.</p>
    <div class="table-responsive" role="region" aria-label="Tabela de produtos cadastrados pela loja" aria-describedby="ajudaRolagemProdutos" tabindex="0">
      <table class="table align-middle mb-0">
        <caption class="visually-hidden">Produtos cadastrados pela loja</caption>
        <thead>
          <tr>
            <th scope="col">Produto</th>
            <th scope="col">Categoria</th>
            <th scope="col">Preço</th>
            <th scope="col">Estoque</th>
            <th scope="col">Estado</th>
            <th scope="col"><span class="visually-hidden">Ações</span></th>
          </tr>
        </thead>
        <tbody>
          <% produtos.forEach((produto) => { %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-3">
                  <img class="table-thumb" src="<%= produto.imagem %>" alt="">
                  <strong><%= produto.nome %></strong>
                </div>
              </td>
              <td><%= produto.categoria.nome %></td>
              <td><%= Number(produto.preco).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></td>
              <td><%= produto.estoque %></td>
              <td>
                <span class="status-pill"><%= produto.estado %></span>
              </td>
              <td>
                <div class="d-flex justify-content-end gap-1">
                  <a class="btn btn-sm btn-outline-dark" href="/vendedor/produtos/<%= produto.id %>/editar">Editar <span class="visually-hidden"><%= produto.nome %></span></a>
                  <form action="/vendedor/produtos/<%= produto.id %>/estado" method="post">
                    <button class="btn btn-sm btn-outline-secondary"><%= produto.estado === 'ativo' ? 'Desativar' : 'Ativar' %> <span class="visually-hidden"><%= produto.nome %></span></button>
                  </form>
                  <form action="/vendedor/produtos/<%= produto.id %>/excluir" method="post" data-confirmar="Excluir ou desativar este produto?">
                    <button class="btn btn-sm btn-outline-danger">Excluir <span class="visually-hidden"><%= produto.nome %></span></button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>
