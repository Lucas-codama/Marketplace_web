<section>
  <div class="section-heading">
    <div>
      <span class="eyebrow">NXT Seller</span>
      <h1>Painel do vendedor</h1>
    </div>
    <a class="btn btn-dark" href="/vendedor/produtos/novo">Novo produto</a>
  </div>
  <div class="metric-grid mb-5">
    <article class="metric-card">
      <span>Produtos</span>
      <strong><%= resumo.total %></strong>
      <small><%= resumo.ativos %> ativos</small>
    </article>
    <article class="metric-card">
      <span>Sem estoque</span>
      <strong><%= resumo.semEstoque %></strong>
      <small><%= resumo.baixo %> com estoque baixo</small>
    </article>
    <article class="metric-card">
      <span>Unidades vendidas</span>
      <strong><%= resumo.unidades %></strong>
      <small><%= resumo.pendentes %> pedidos pendentes</small>
    </article>
    <article class="metric-card accent">
      <span>Vendas simuladas</span>
      <strong><%= moeda(resumo.valor) %></strong>
      <small>Valor acumulado</small>
    </article>
  </div>
  <nav class="admin-shortcuts mb-5" aria-label="Áreas da loja">
    <a href="/vendedor/produtos">Produtos <span>→</span>
    </a>
    <a href="/vendedor/estoque">Estoque <span>→</span>
    </a>
    <a href="/vendedor/pedidos">Pedidos <span>→</span>
    </a>
    <a href="/vendedor/avaliacoes">Avaliações <span>→</span>
    </a>
    <a href="/perfil">Perfil da loja <span>→</span>
    </a>
  </nav>
  <div class="section-heading">
    <div>
      <span class="eyebrow">Movimento</span>
      <h2>Pedidos recentes</h2>
    </div>
  </div>
  <div class="table-shell">
    <table>
      <caption class="visually-hidden">Pedidos recentes da loja</caption>
      <thead>
        <tr>
          <th scope="col">Pedido</th>
          <th scope="col">Itens</th>
          <th scope="col">Valor da loja</th>
          <th scope="col">Estado</th>
        </tr>
      </thead>
      <tbody>
        <% recentes.forEach((pedido) => { %>
          <tr>
            <td>
              <a href="/vendedor/pedidos/<%= pedido.id %>">
                <strong><%= pedido.numero %></strong>
              </a>
            </td>
            <td><%= pedido.itens.reduce((soma, item) => soma + item.quantidade, 0) %></td>
            <td><%= moeda(pedido.itens.reduce((soma, item) => soma + Number(item.subtotal), 0)) %></td>
            <td>
              <span class="status status-<%= pedido.estado %>"><%= pedido.estado.replaceAll('_', ' ') %></span>
            </td>
          </tr>
        <% }) %>
        <% if (!recentes.length) { %>
          <tr>
            <td colspan="4" class="empty-cell">Nenhum pedido recebido.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <div class="section-heading section-block">
    <div>
      <span class="eyebrow">Reputação</span>
      <h2>Avaliações recentes</h2>
    </div>
    <a href="/vendedor/avaliacoes">Ver todas →</a>
  </div>
  <div class="reviews-grid">
    <% avaliacoesRecentes.forEach((avaliacao) => { %>
      <article class="review-card">
        <div class="review-head">
          <strong><%= avaliacao.produto.nome %></strong>
          <small><%= avaliacao.cliente.nomeCompleto %></small>
        </div>
        <div class="stars" role="img" aria-label="<%= avaliacao.nota %> de 5 estrelas"><%= '★'.repeat(avaliacao.nota) %><%= '☆'.repeat(5 - avaliacao.nota) %></div>
        <p><%= avaliacao.comentario %></p>
      </article>
    <% }) %>
    <% if (!avaliacoesRecentes.length) { %>
      <div class="empty-state">Nenhuma avaliação aprovada ainda.</div>
    <% } %>
  </div>
</section>
