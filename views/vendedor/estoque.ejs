<section>
  <div class="section-heading">
    <div>
      <span class="eyebrow">Operação</span>
      <h1>Estoque</h1>
    </div>
  </div>
  <div id="mensagemVendedor">
  </div>
  <div class="surface overflow-hidden">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <caption class="visually-hidden">Estoque dos produtos da loja</caption>
        <thead>
          <tr>
            <th scope="col">Produto</th>
            <th scope="col">Categoria</th>
            <th scope="col">Quantidade</th>
            <th scope="col"><span class="visually-hidden">Ações</span></th>
          </tr>
        </thead>
        <tbody>
          <% produtos.forEach((produto) => { %>
            <tr data-produto-id="<%= produto.id %>">
              <td>
                <strong><%= produto.nome %></strong>
              </td>
              <td><%= produto.categoria.nome %></td>
              <td>
                <label class="visually-hidden" for="estoqueProduto<%= produto.id %>">Quantidade em estoque de <%= produto.nome %></label>
                <input id="estoqueProduto<%= produto.id %>" class="form-control js-estoque" type="number" min="0" step="1" value="<%= produto.estoque %>">
              </td>
              <td class="text-end">
                <button type="button" class="btn btn-sm btn-dark js-salvar-estoque">Salvar <span class="visually-hidden">estoque de <%= produto.nome %></span></button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>
<script src="/js/vendedor.js">
</script>
