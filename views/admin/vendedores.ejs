<section class="page-head">
  <div>
    <span class="eyebrow">Gestão</span>
    <h1>Vendedores</h1>
    <p>Controle lojas, vendedores e seus acessos.</p>
  </div>
</section>
<div class="table-shell">
  <table>
    <thead>
      <tr>
        <th>Loja</th>
        <th>Responsável</th>
        <th>Produtos</th>
        <th>Status</th>
        <th>Ação</th>
      </tr>
    </thead>
    <tbody>
      <% vendedores.forEach((vendedor) => { %>
        <tr>
          <td>
            <strong><%= vendedor.perfilVendedor?.nomeLoja || 'Perfil incompleto' %></strong>
            <small><%= vendedor.perfilVendedor?.cidade || 'Cidade não informada' %><%= vendedor.perfilVendedor?.uf ? ` · ${vendedor.perfilVendedor.uf}` : '' %></small>
          </td>
          <td><%= vendedor.nomeCompleto %><small>@<%= vendedor.username %></small>
          </td>
          <td><%= vendedor.produtosVenda.length %></td>
          <td>
            <span class="status status-<%= vendedor.status %>"><%= vendedor.status %></span>
          </td>
          <td>
            <button class="btn btn-sm btn-outline-dark js-status" data-url="/admin/api/vendedores/<%= vendedor.id %>/status" data-status="<%= vendedor.status === 'ativo' ? 'bloqueado' : 'ativo' %>"><%= vendedor.status === 'ativo' ? 'Bloquear' : 'Ativar' %></button>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<script src="/js/admin.js" defer>
</script>
