<section class="page-head">
  <div>
    <span class="eyebrow">Moderação</span>
    <h1>Produtos</h1>
    <p>Revise e controle anúncios da loja virtual.</p>
  </div>
</section>
<form class="filter-bar" method="get">
  <label class="visually-hidden" for="filtroEstadoProduto">Estado do produto</label>
  <select id="filtroEstadoProduto" class="form-select" name="estado">
    <option value="">Todos os estados</option>
    <% ['ativo','inativo','bloqueado'].forEach((item) => { %>
      <option value="<%= item %>" <%= estado === item ? 'selected' : '' %>><%= item %></option>
    <% }) %>
  </select>
  <button class="btn btn-dark">Filtrar</button>
</form>
<div class="table-shell" role="region" aria-label="Tabela de produtos" tabindex="0">
  <table>
    <caption class="visually-hidden">Produtos da loja virtual</caption>
    <thead>
      <tr>
        <th scope="col">Produto</th>
        <th scope="col">Vendedor</th>
        <th scope="col">Categoria</th>
        <th scope="col">Estoque</th>
        <th scope="col">Estado</th>
        <th scope="col">Ação</th>
      </tr>
    </thead>
    <tbody>
      <% produtos.forEach((produto) => { %>
        <tr>
          <td>
            <a href="/produtos/<%= produto.id %>">
              <strong><%= produto.nome %></strong>
            </a>
            <small><%= moeda(produto.preco) %></small>
          </td>
          <td><%= produto.vendedor.nomeCompleto %></td>
          <td><%= produto.categoria.nome %></td>
          <td><%= produto.estoque %></td>
          <td>
            <span class="status status-<%= produto.estado %>"><%= produto.estado %></span>
          </td>
          <td>
            <label class="visually-hidden" for="estadoProduto<%= produto.id %>">Alterar estado de <%= produto.nome %></label>
            <select id="estadoProduto<%= produto.id %>" class="form-select form-select-sm js-select-status" data-url="/admin/api/produtos/<%= produto.id %>/estado" data-key="estado">
              <% ['ativo','inativo','bloqueado'].forEach((item) => { %>
                <option <%= produto.estado === item ? 'selected' : '' %>><%= item %></option>
              <% }) %>
            </select>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<script src="/js/admin.js" defer>
</script>
