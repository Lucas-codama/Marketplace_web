<!DOCTYPE html>
<html lang="pt-BR"<% if (usuario) { %> data-alto-contraste="<%= usuario.altoContraste ? '1' : '0' %>" data-escala-fonte="<%= usuario.escalaFonte %>"<% } %>>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="NXT PLAY — marketplace multi-vendedor de games, consoles e acessórios.">
    <title><%= typeof titulo !== 'undefined' ? `${titulo} | NXT PLAY` : 'NXT PLAY' %></title>
        <script>
      (function aplicarPreferenciasDeAcessibilidade() {
        try {
          var html = document.documentElement;
          if (!html.hasAttribute('data-alto-contraste')) return;

          var altoContraste = html.getAttribute('data-alto-contraste') === '1';
          var escalaFonte = Number(html.getAttribute('data-escala-fonte')) || 1;

          if (altoContraste) html.classList.add('alto-contraste');
          html.style.setProperty('--fonte-escala', escalaFonte);
        } catch (erro) {}
      })();
    </script>
    <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/estilo.css">
    <script src="/vendor/jquery/jquery.min.js">
    </script>
  </head>
  <body>
    <header class="site-header">
      <nav class="navbar navbar-expand-xl">
        <div class="container-xxl px-3 px-lg-4">
          <a class="navbar-brand" href="/">
            <span class="brand-mark">NXT</span> PLAY</a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-controls="menu" aria-expanded="false" aria-label="Abrir menu">
            <span class="navbar-toggler-icon">
            </span>
          </button>
          <div class="collapse navbar-collapse" id="menu">
            <div class="navbar-nav ms-auto align-items-xl-center gap-xl-1">
              <a class="nav-link" href="/">Início</a>
              <a class="nav-link" href="/catalogo">Catálogo</a>
              <a class="nav-link" href="/acessibilidades">Acessibilidades</a>
              <% if (usuario?.papel === 'cliente') { %>
                <a class="nav-link" href="/carrinho">Carrinho <span id="contadorCarrinho" class="badge text-bg-dark">0</span>
                </a>
                <a class="nav-link" href="/pedidos">Pedidos</a>
                <a class="nav-link" href="/enderecos">Endereços</a>
              <% } %>
              <% if (usuario?.papel === 'vendedor') { %>
                <a class="nav-link" href="/vendedor">Painel</a>
                <a class="nav-link" href="/vendedor/produtos">Produtos</a>
                <a class="nav-link" href="/vendedor/pedidos">Vendas</a>
              <% } %>
              <% if (usuario?.papel === 'admin') { %>
                <a class="nav-link" href="/admin">Admin</a>
              <% } %>
              <% if (usuario) { %>
                <a class="nav-link" href="/notificacoes">Avisos <span id="contadorNotificacoes" class="badge text-bg-success d-none">0</span>
                </a>
                <a class="nav-link" href="/perfil">@<%= usuario.username %></a>
                <form action="/logout" method="post">
                  <button class="btn btn-sm btn-outline-dark">Sair</button>
                </form>
                <% } else { %>
                <a class="nav-link" href="/login">Entrar</a>
                <a class="btn btn-sm btn-dark" href="/cadastro">Criar conta</a>
              <% } %>
            </div>
          </div>
        </div>
      </nav>
    </header>
    <main class="container-xxl px-3 px-lg-4 py-5">
      <% if (flash) { %>
        <div class="alert alert-<%= flash.tipo %> alert-dismissible fade show js-flash"><%= flash.mensagem %><button class="btn-close" data-bs-dismiss="alert" aria-label="Fechar">
          </button>
        </div>
      <% } %><%- body %>
    </main>
    <footer class="site-footer">
      <div class="container-xxl px-3 px-lg-4 d-flex flex-column flex-lg-row justify-content-between gap-3">
        <div>
          <span class="navbar-brand text-white">
            <span class="brand-mark">NXT</span> PLAY</span>
          <p class="text-white-50 mt-3 mb-0">O próximo nível do seu setup.</p>
        </div>
        <p class="text-white-50 mb-0 align-self-lg-end">
        </p>
      </div>
    </footer>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js">
    </script>
    <script src="/socket.io/socket.io.js">
    </script>
    <script src="/js/app.js">
    </script>
    <script src="/js/notificacoes.js">
    </script>
    
    <script src="/js/acessibilidade.js">
    </script>
    <script src="/js/socket.js">
    </script>