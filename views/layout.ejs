<!DOCTYPE html>
<html lang="pt-BR"<% if (usuario) { %> data-alto-contraste="<%= usuario.altoContraste ? '1' : '0' %>" data-escala-fonte="<%= usuario.escalaFonte %>"<% } %>>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="NXT PLAY — comércio eletrônico com vários vendedores de jogos, consoles e acessórios.">
    <title><%= typeof titulo !== 'undefined' ? `${titulo} | NXT PLAY` : 'NXT PLAY' %></title>
        <script>
      (function aplicarPreferenciasDeAcessibilidade() {
        try {
          var html = document.documentElement;
          var usuarioLogado = html.hasAttribute('data-alto-contraste');
          var altoContraste = false;
          var escalaFonte = 1;

          if (usuarioLogado) {
            altoContraste = html.getAttribute('data-alto-contraste') === '1';
            escalaFonte = Number(html.getAttribute('data-escala-fonte')) || 1;
          } else {
            var preferenciasSalvas = JSON.parse(localStorage.getItem('nxtplay:acessibilidade') || '{}');
            altoContraste = preferenciasSalvas.altoContraste === true;
            escalaFonte = Number(preferenciasSalvas.escalaFonte) || 1;
          }

          escalaFonte = Math.min(2, Math.max(.85, escalaFonte));

          if (altoContraste) html.classList.add('alto-contraste');
          html.style.setProperty('--fonte-escala', escalaFonte);
        } catch (erro) {}
      })();
    </script>
    <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/estilo.css">
    <script src="/vendor/jquery/jquery.min.js">
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo-principal">Ir para o conteúdo principal</a>
    <header class="site-header">
      <nav class="navbar navbar-expand-xxl" aria-label="Navegação principal">
        <div class="container-xxl px-3 px-lg-4">
          <a class="navbar-brand" href="/" aria-label="NXT PLAY — página inicial">
            <span class="brand-mark">NXT</span> PLAY</a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-controls="menu" aria-expanded="false" aria-label="Abrir menu">
            <span class="navbar-toggler-icon">
            </span>
          </button>
          <div class="collapse navbar-collapse" id="menu">
            <div class="navbar-nav ms-auto align-items-xxl-center gap-xxl-1">
              <a class="nav-link" href="/"<%- caminhoAtual === '/' ? ' aria-current="page"' : '' %>>Início</a>
              <a class="nav-link" href="/catalogo"<%- caminhoAtual.startsWith('/catalogo') || caminhoAtual.startsWith('/produtos/') ? ' aria-current="page"' : '' %>>Catálogo</a>
              <a class="nav-link" href="/acessibilidades"<%- caminhoAtual.startsWith('/acessibilidades') ? ' aria-current="page"' : '' %>>Acessibilidade</a>
              <a class="nav-link" href="/mapa-do-site"<%- caminhoAtual === '/mapa-do-site' ? ' aria-current="page"' : '' %>>Mapa do site</a>
              <% if (usuario?.papel === 'cliente') { %>
                <a class="nav-link" href="/carrinho"<%- caminhoAtual.startsWith('/carrinho') || caminhoAtual.startsWith('/checkout') ? ' aria-current="page"' : '' %>>Carrinho <span id="contadorCarrinho" class="badge text-bg-dark" aria-live="polite" aria-atomic="true">0</span>
                </a>
                <a class="nav-link" href="/pedidos"<%- caminhoAtual.startsWith('/pedidos') ? ' aria-current="page"' : '' %>>Pedidos</a>
                <a class="nav-link" href="/enderecos"<%- caminhoAtual.startsWith('/enderecos') ? ' aria-current="page"' : '' %>>Endereços</a>
              <% } %>
              <% if (usuario?.papel === 'vendedor') { %>
                <a class="nav-link" href="/vendedor"<%- caminhoAtual === '/vendedor' ? ' aria-current="page"' : '' %>>Painel</a>
                <a class="nav-link" href="/vendedor/produtos"<%- caminhoAtual.startsWith('/vendedor/produtos') ? ' aria-current="page"' : '' %>>Produtos</a>
                <a class="nav-link" href="/vendedor/pedidos"<%- caminhoAtual.startsWith('/vendedor/pedidos') ? ' aria-current="page"' : '' %>>Vendas</a>
              <% } %>
              <% if (usuario?.papel === 'admin') { %>
                <a class="nav-link" href="/admin"<%- caminhoAtual.startsWith('/admin') ? ' aria-current="page"' : '' %>>Admin</a>
              <% } %>
              <% if (usuario) { %>
                <a class="nav-link" href="/notificacoes"<%- caminhoAtual.startsWith('/notificacoes') ? ' aria-current="page"' : '' %>>Notificações <span id="contadorNotificacoes" class="badge text-bg-success d-none" aria-live="polite" aria-atomic="true">0</span>
                </a>
                <a class="nav-link" href="/perfil"<%- caminhoAtual.startsWith('/perfil') ? ' aria-current="page"' : '' %>>@<%= usuario.username %></a>
                <form action="/logout" method="post">
                  <button class="btn btn-sm btn-outline-dark">Sair</button>
                </form>
                <% } else { %>
                <a class="nav-link" href="/login">Entrar</a>
                <a class="btn btn-sm btn-dark" href="/cadastro">Criar conta</a>
              <% } %>
            </div>
          </div>
        </div>
      </nav>
    </header>
    <main id="conteudo-principal" class="container-xxl px-3 px-lg-4 py-5" tabindex="-1">
      <% if (flash) { %>
        <div class="alert alert-<%= flash.tipo %> alert-dismissible fade show js-flash" role="<%= flash.tipo === 'danger' ? 'alert' : 'status' %>" aria-atomic="true"><%= flash.mensagem %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar mensagem">
          </button>
        </div>
      <% } %><%- body %>
    </main>
    <footer class="site-footer">
      <div class="container-xxl px-3 px-lg-4 d-flex flex-column flex-lg-row justify-content-between gap-3">
        <div>
          <span class="navbar-brand text-white">
            <span class="brand-mark">NXT</span> PLAY</span>
          <p class="text-white-50 mt-3 mb-0">O próximo nível dos seus equipamentos.</p>
        </div>
        <nav class="footer-nav align-self-lg-end" aria-label="Navegação complementar">
          <a href="/">Início</a>
          <a href="/catalogo">Catálogo</a>
          <a href="/acessibilidades">Acessibilidade</a>
          <a href="/mapa-do-site">Mapa do site</a>
        </nav>
      </div>
    </footer>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js">
    </script>
    <script src="/socket.io/socket.io.js">
    </script>
    <script src="/js/app.js">
    </script>
    <script src="/js/notificacoes.js">
    </script>
    
    <script src="/js/acessibilidade.js">
    </script>
    <script src="/js/socket.js">
    </script>
  </body>
</html>
