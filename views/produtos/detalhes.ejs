<section data-acompanhar-produto="<%= produto.id %>">
  <div class="row g-5 align-items-start">
    <div class="col-lg-7">
      <div class="product-detail-image"><img src="<%= produto.imagem %>" alt="<%= produto.nome %>"></div>
    </div>
    <div class="col-lg-5"><span class="eyebrow">
        <%= produto.categoria.nome %>
      </span>
      <h1 class="display-5 mt-2">
        <%= produto.nome %>
      </h1>
      <p class="text-secondary">
        <%= produto.descricao %>
      </p><a href="/vendedores/<%= produto.vendedor.perfilVendedor?.slug %>" class="seller-pill">Vendido por <strong>
          <%= produto.vendedor.perfilVendedor?.nomeLoja || produto.vendedor.username %>
        </strong></a>
      <p class="price-display">
        <%= Number(produto.preco).toLocaleString('pt-BR', { style: 'currency' , currency: 'BRL' }) %>
      </p>
      <p>Estoque: <strong class="js-estoque-produto">
          <%= produto.estoque %>
        </strong></p>
      <div id="mensagemCarrinho"></div>
      <% if (usuario?.papel==='cliente' && produto.estoque> 0) { %><form class="js-form-adicionar-carrinho"
          data-produto-id="<%= produto.id %>">
          <div class="d-flex gap-2"><input class="form-control quantity-input" name="quantidade" type="number" value="1"
              min="1" max="<%= produto.estoque %>"><button class="btn btn-dark flex-grow-1">Adicionar ao
              carrinho</button></div>
        </form>
        <% } else if (!usuario) { %><a class="btn btn-dark w-100" href="/login">Entre para comprar</a>
          <% } else { %><button class="btn btn-secondary w-100" disabled>Indisponível</button>
            <% } %>
    </div>
  </div>
  <div id="avaliacoesProduto" class="mt-5" data-produto-id="<%= produto.id %>">
    <div class="section-heading">
      <div><span class="eyebrow">Comunidade</span>
        <h2>Avaliações</h2>
        <p><span id="mediaAvaliacoes">
            <%= media.toFixed(1) %>
          </span> · <span id="quantidadeAvaliacoes">
            <%= produto.avaliacoes.length %> avaliações
          </span></p>
      </div>
      <% if (usuario?.papel==='cliente' ) { %><a class="btn btn-outline-dark"
          href="/produtos/<%= produto.id %>/avaliar">Avaliar</a>
        <% } %>
    </div>
    <div id="listaAvaliacoes" class="reviews-grid"></div>
  </div>
  <% if (relacionados.length) { %>
    <div class="mt-5">
      <div class="section-heading">
        <h2>Relacionados</h2>
      </div>
      <div class="row g-3">
        <% relacionados.forEach((item)=> { %><div class="col-6 col-lg-3"><%- include('../partials/produto-card', {
              produto: item }) %></div>
          <% }) %>
      </div>
    </div>
    <% } %>
</section>
<script src="/js/carrinho.js"></script>
<script src="/js/avaliacoes.js"></script>