<section>
  <div class="section-heading">
    <div>
      <span class="eyebrow">Preferências</span>
      <h1>Acessibilidade</h1>
      <p class="text-secondary mb-0">Ajuste o contraste e o tamanho da fonte para navegar com mais conforto. As preferências ficam salvas neste navegador.</p>
    </div>
  </div>

  <div class="d-grid gap-3 mt-4">
    <div class="acessibilidade-card">
      <div>
        <h2 class="h5 mb-1">Alto contraste</h2>
        <p class="text-secondary mb-0">Aumenta o contraste de cores em todo o site para facilitar a leitura.</p>
      </div>
      <div class="form-check form-switch fs-4 mb-0">
        <input class="form-check-input" type="checkbox" role="switch" id="acessibilidadeContraste" aria-label="Ativar alto contraste">
      </div>
    </div>

    <div class="acessibilidade-card">
      <div>
        <h2 class="h5 mb-1">Tamanho da fonte</h2>
        <p class="text-secondary mb-0">Aumente ou diminua o tamanho do texto em todo o site.</p>
      </div>
      <div class="acessibilidade-controle-fonte">
        <button type="button" id="acessibilidadeDiminuir" class="btn btn-outline-dark" aria-label="Diminuir fonte">A-</button>
        <span id="acessibilidadeEscalaValor">100%</span>
        <button type="button" id="acessibilidadeAumentar" class="btn btn-outline-dark" aria-label="Aumentar fonte">A+</button>
        <button type="button" id="acessibilidadeRestaurar" class="btn btn-outline-dark" aria-label="Restaurar tamanho padrão">Restaurar</button>
      </div>
    </div>
  </div>
</section>
