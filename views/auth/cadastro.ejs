<section class="row justify-content-center">
  <div class="col-lg-6 col-xl-5">
    <div class="mb-4">
      <p class="text-uppercase fw-bold text-success mb-2">
        NXT PLAY
      </p>

      <h1 class="display-5 fw-bold">
        Criar conta
      </h1>

      <p class="text-secondary">
        Cadastre-se como cliente para comprar
        jogos, consoles e acessórios.
      </p>
    </div>

    <% if (erros && erros.length > 0) { %>
      <div id="errosCadastro" class="alert alert-danger" role="alert" aria-atomic="true">
        <strong>Verifique os dados informados:</strong>

        <ul class="mb-0 mt-2">
          <% erros.forEach((erro) => { %>
            <li><%= erro %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form action="/cadastro" method="post" class="card border-0 shadow-sm"<%- erros?.length ? ' aria-describedby="errosCadastro"' : '' %>>
      <div class="card-body p-4">
        <div class="mb-3">
          <label for="nomeCompleto" class="form-label">
            Nome completo
          </label>

          <input
            type="text"
            id="nomeCompleto"
            name="nomeCompleto"
            class="form-control"
            value="<%= valores.nomeCompleto || '' %>"
            minlength="3"
            maxlength="120"
            autocomplete="name"
            required
          >
        </div>

        <div class="mb-3">
          <label for="username" class="form-label">
            Nome de usuário
          </label>

          <input
            type="text"
            id="username"
            name="username"
            class="form-control"
            value="<%= valores.username || '' %>"
            minlength="3"
            maxlength="30"
            pattern="[A-Za-z0-9_]+"
            autocomplete="username"
            aria-describedby="usernameAjuda"
            required
          >

          <div id="usernameAjuda" class="form-text">
            Use letras, números e sublinhados.
          </div>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label">
            E-mail
          </label>

          <input
            type="email"
            id="email"
            name="email"
            class="form-control"
            value="<%= valores.email || '' %>"
            maxlength="160"
            autocomplete="email"
            required
          >
        </div>

        <div class="mb-3">
          <label for="password" class="form-label">
            Senha
          </label>

          <div class="password-field">
            <input
              type="password"
              id="password"
              name="password"
              class="form-control"
              minlength="8"
              autocomplete="new-password"
              aria-describedby="senhaAjuda"
              required
            >
            <button type="button" class="btn btn-outline-dark" data-password-toggle aria-controls="password" aria-pressed="false">Mostrar senha</button>
          </div>

          <div id="senhaAjuda" class="form-text">
            Use pelo menos 8 caracteres.
          </div>
        </div>

        <div class="mb-4">
          <label for="confirmarPassword" class="form-label">
            Confirmar senha
          </label>

          <div class="password-field">
            <input
              type="password"
              id="confirmarPassword"
              name="confirmarPassword"
              class="form-control"
              minlength="8"
              autocomplete="new-password"
              required
            >
            <button type="button" class="btn btn-outline-dark" data-password-toggle aria-controls="confirmarPassword" aria-pressed="false">Mostrar senha</button>
          </div>
        </div>

        <button type="submit" class="btn btn-dark w-100">
          Criar minha conta
        </button>
      </div>
    </form>

    <p class="text-center mt-4">
      Já possui uma conta?
      <a href="/login">Entrar</a>
    </p>
  </div>
</section>
